{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ManyWatch",
    "Audience": "ManyWatch.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RoomPresence": {
    "MemberTimeout": "00:02:00",
    "CleanupInterval": "00:00:15"
  }
}
